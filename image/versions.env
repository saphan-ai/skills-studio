# Image settings for make image, image-check, scan and push. A variable already set in the environment is kept.
# Every base image is pinned by version AND digest; image/scripts/lib.sh refuses one that is not.
# Digests read with `docker buildx imagetools inspect` on 2026-11-02.
GOLANG_IMAGE=golang:1.26.10@sha256:670bb5aa5349ae03b8516764718486f4f16399134bdc9acd0c46a23f043ab05c
RUNTIME_IMAGE=gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab

SKILLS_REGISTRY=docker.io
SKILLS_IMAGE=saphan/skills
PUSH_PLATFORMS=linux/amd64,linux/arm64

SCOUT_REFUSE_SEVERITIES=critical,high
